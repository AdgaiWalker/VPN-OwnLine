[Unit]
Description=Rotate endpoint for ladder page
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/web/admin.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
StateDirectory=ownline
StateDirectoryMode=0700
ReadWritePaths=/opt /etc/sing-box /etc/caddy /run
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN CAP_KILL
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap @clock @module @raw-io @debug @cpu-emulation @obsolete
UMask=0077

[Install]
WantedBy=multi-user.target
