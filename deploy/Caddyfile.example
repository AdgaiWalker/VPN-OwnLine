# 原生内置订阅：由 admin.py 统一处理，无需 subconverter 外部服务
(app) {
	redir /p / 308
	redir /p/* / 308

	# 订阅路由：直接交由 admin.py 处理（支持 Base64 / Clash YAML 智能分发与 Token 鉴权）
	handle /s/* {
		reverse_proxy 127.0.0.1:8099
	}

	@blocked path /sub*
	handle @blocked {
		respond 404
	}

	# 数据都在 /opt/web-data，不在网站根目录，正常取不到。
	# 这条是第二道防线：万一有人把 json 又放回 /opt/web，也不会被发出去。
	@sensitive path /tc.json /nodes.json /retired-nodes-*.json
	handle @sensitive {
		respond 404
	}

	# 面板前端直接 fetch 这四个，从数据目录发
	@pubjson path /status.json /servers.json /usage.json /quota.json
	handle @pubjson {
		basic_auth {
			admin <BCRYPT_HASH_OF_YOUR_PASSWORD>
		}
		header Cache-Control "no-store"
		root * /opt/web-data
		file_server
	}

	handle_path /api/* {
	basic_auth {
		admin <BCRYPT_HASH_OF_YOUR_PASSWORD>
	}
		reverse_proxy 127.0.0.1:8099
	}

	handle {
	basic_auth {
		admin <BCRYPT_HASH_OF_YOUR_PASSWORD>
	}
		header Cache-Control "no-store"
		root * /opt/web
		file_server
	}
}

:80 {
	import app
}

https://v.example.com:8443 {
	tls internal
	import app
}
