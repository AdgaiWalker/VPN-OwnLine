# 原生内置订阅：由 admin.py 动态生成与分发
{
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

(app) {
	header -Server
	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "DENY"
	header Referrer-Policy "no-referrer"
	handle_errors {
		header -Server
	}

	redir /p / 308
	redir /p/* / 308

	# 免密自举路由：直接交由 admin.py 处理（一次性高熵 Token 鉴权，支持全自动入网）
	handle /join/* {
		reverse_proxy 127.0.0.1:8099
	}

	# 订阅路由：直接交由 admin.py 处理（支持 Base64 / Clash YAML 智能分发与 Token 鉴权）
	handle /s/* {
		reverse_proxy 127.0.0.1:8099
	}

	@blocked path /sub*
	handle @blocked {
		respond 404
	}

	# 数据都在 /opt/web-data，不在网站根目录，正常取不到。
	# 这条是第二道防线：万一有人把 json 又放回 /opt/web，也不会被发出去。
	@sensitive path /tc.json /nodes.json /retired-nodes-*.json
	handle @sensitive {
		respond 404
	}

	# 面板前端直接 fetch 状态快照，由 admin.py 受控反代输出，Caddy 不直读 DATA 目录
	@pubjson path /status.json /servers.json /usage.json /quota.json
	handle @pubjson {
		basic_auth {
			admin <BCRYPT_HASH_OF_YOUR_PASSWORD>
		}
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8099
	}

	handle_path /api/* {
		basic_auth {
			admin <BCRYPT_HASH_OF_YOUR_PASSWORD>
		}
		reverse_proxy 127.0.0.1:8099
	}

	handle {
		basic_auth {
			admin <BCRYPT_HASH_OF_YOUR_PASSWORD>
		}
		header Cache-Control "no-store"
		root * /opt/web
		file_server
	}
}

https://v.example.com:8443 {
	tls internal
	import app
}
